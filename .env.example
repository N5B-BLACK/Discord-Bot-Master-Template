# انسخ هذا الملف باسم .env واملأ القيم الحقيقية
# لا ترفع ملف .env نفسه على GitHub أبداً (موجود بالـ .gitignore أصلاً)

# --- أساسي ---
DISCORD_TOKEN=
BOT_PREFIX=!
GUILD_ID=

# --- قاعدة البيانات (MongoDB Atlas - مجاني) ---
# رولات وقنوات كل سيرفر صارت تنضبط عن طريق أمر /setup داخل ديسكورد نفسه،
# وتتخزن هون - ما عاد تحتاج تحط IDs يدوي بهذا الملف.
MONGODB_URI=

# --- الذكاء الاصطناعي (عبر OpenRouter) ---
OPENROUTER_API_KEY=
AI_MODEL=openrouter/free

# --- تخصيص الهوية ---
BOT_NAME=KZN
WELCOME_MESSAGE=أهلاً فيك {member} بسيرفر {guild}! 🎉
EMBED_COLOR=0x5865F2

# --- الداشبورد (تسجيل دخول Discord OAuth2) ---
# احصل عليهم من https://discord.com/developers/applications -> تطبيقك -> OAuth2
# REDIRECT_URI لازم تكون بالضبط نفس الرابط المسجل بصفحة OAuth2 بموقع Discord،
# وينتهي بـ /callback (مثال: https://your-app.onrender.com/callback)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DASHBOARD_SECRET_KEY=
REDIRECT_URI=

# --- الميوزك (اختياري) ---
# لو يوتيوب صار يرفض التشغيل برسالة "Sign in to confirm you're not a bot"، فيك تصدّر
# cookies.txt (بصيغة Netscape) من حساب يوتيوب حقيقي مسجل دخول، وتشفرها base64، وتحطها هون.
# البوت بيشتغل تمام بدونها، بس أقل موثوقية بهاي الحالة تحديداً. راجع utils/music_source.py.
YTDLP_COOKIES_B64=
